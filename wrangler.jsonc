{
 "name":"wppoffice-montevideo",
 "main":"cloudflare/worker.mjs",
 "compatibility_date":"2026-11-10",
 "workers_dev":true,
 "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":["/session/*","/voice/*","/health"]},
 "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"VisitRoom"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["VisitRoom"]}]
}
